{
  "spec": "CONTROL.md §14.7 step 7",
  "note": "A rule runs at most once a machine-local day for one subject in one state. The same card moved to TODO again the same day is acked `refused` with `cooldown`; the same card in another state, or on the next day, is a new run.",
  "cases": [
    {
      "name": "the same card in the same state twice in a day",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe",
          "harnesses": [
