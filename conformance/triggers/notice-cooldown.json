            "/home/sam/.codex"
          ],
          "system": [],
          "platform": "linux"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-todo",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "start": "claude-code"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 5
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          }
        ]
      },
      "zone": "UTC",
      "steps": [
        {
