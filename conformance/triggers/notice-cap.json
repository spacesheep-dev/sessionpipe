{
  "spec": "CONTROL.md §14.7 step 8",
  "note": "A rule runs at most `cap.per_day` times a machine-local day; every run counts, whether it then works or fails. Past the cap a notice it takes is acked `refused` with `cap`. The next local day counts from nothing. `today` is the runs the rule had already made that day.",
  "cases": [
    {
      "name": "the third card in a day, on a cap of two",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe",
          "harnesses": [
            "/home/sam/.claude",
            "/home/sam/.codex"
          ],
          "system": [],
          "platform": "linux"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-todo",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "start": "claude-code"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 2
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          }
        ]
      },
      "zone": "UTC",
      "today": [
        {
          "rule": "card-todo",
          "subject": "X-001",
          "state": "todo",
          "at": "2026-11-24T08:00:00.000Z",
          "result": "ran"
