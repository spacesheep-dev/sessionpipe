{
  "spec": "CONTROL.md §14.6 (the clock)",
  "note": "A clock rule ticks at its time in the machine's local time (`zone`). A tick missed while the machine slept (`asleep` from, `wake` at) runs once on waking when the latest missed tick is under six hours late, and never more than once however many were missed; six hours late or more it is `missed`, a line in the rule's history that never counts against the cap. A paused rule's tick is nothing, on or off. A tick that runs takes the run's checks (the folder, the harness, the start caps, where it waits) as a notice's run does. No receiver is involved, so no ack.",
  "cases": [
    {
      "name": "on time",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe",
          "harnesses": [
            "/home/sam/.claude",
            "/home/sam/.codex"
          ],
          "platform": "linux"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "monday-report",
            "paused": false,
            "source": {
              "every": "mon 09:00"
            },
            "target": {
              "start": "codex"
            },
            "folder": "~/work/sales",
            "level": "safe",
            "cap": {
              "per_day": 1
            },
            "words": "Make last week's sales report from data/ into reports/."
          }
        ]
      },
      "zone": "UTC",
      "steps": [
        {
          "at": "2026-11-23T09:00:00.000Z",
          "tick": "monday-report",
          "expect": {
            "runs": [
              {
                "rule": "monday-report",
                "run": {
                  "target": {
                    "start": "codex"
                  },
                  "folder": "~/work/sales",
                  "level": "safe",
                  "tools": [],
                  "words": "Started by trigger monday-report (sessionpipe trigger). These words are the person's.\n\nMake last week's sales report from data/ into reports/."
                },
                "env": {
                  "SESSIONPIPE_TRIGGERED_BY": "monday-report"
                }
              }
            ],
            "history": [
              {
                "rule": "monday-report",
                "result": "ran"
              }
            ]
          }
        }
      ]
    },
