{
  "spec": "CONTROL.md §14.7 (a held session, the machine's caps)",
  "note": "A rule that continues a session a window holds waits until nothing holds it, within the notice's expiry; it never forks a copy and never hands the words to the window. A start counts against the machine's caps on starts (2 running, 10 an hour by default), which a receiver's starts and asks share, and waits for them the same way. A waiting notice is acked `taken` once, and its final ack follows.",
  "cases": [
    {
      "name": "a held session: taken, then run when the window lets go",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-review",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "continue": "codex:019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5b"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 5
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          }
        ]
      },
      "sessions": {
        "codex:019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5b": {
          "level": "edits",
