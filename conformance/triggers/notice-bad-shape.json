{
  "spec": "CONTROL.md §14.2 (the notice)",
  "note": "Notices that are not the closed shape, one way each: too big, a life over a day or none, from the future beyond the 5 minutes of slack, a null or mistyped member, a member named `__proto__`, a token with a line break at its end, a time without milliseconds. Each is acked `refused` `bad_notice` and runs nothing, where the notice otherwise fits card-todo. At exactly 5 minutes ahead a notice is read (notice-no-rule.json's last case is read at 3 seconds).",
  "cases": [
    {
      "name": "more than 1 KiB",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-todo",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "start": "claude-code"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 5
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          }
        ]
      },
      "steps": [
        {
          "at": "2026-11-24T09:14:05.000Z",
          "poll": {
            "receiver": "board.example",
            "body": {
              "messages": [],
              "notices": [
                {
                  "id": "01KB4M2Q8V3T6Y9C0D1E2F004C",
                  "topic": "acme/tasks",
                  "event": "record.updated",
                  "subject": "X-",
                  "state": "todo",
                  "for": "studio-claude",
                  "by": "u-41c9",
                  "at": "2026-11-24T09:14:02.000Z",
                  "expires_at": "2026-11-25T09:14:02.000Z"
                }
              ]
            }
          },
          "expect": {
            "acks": [
              {
                "id": "01KB4M2Q8V3T6Y9C0D1E2F004C",
                "outcome": "refused",
                "code": "bad_notice"
              }
            ],
            "runs": []
          }
        }
      ]
    },
