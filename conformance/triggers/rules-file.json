{
  "spec": "CONTROL.md §14.1 (the rule)",
  "note": "Which `<config>/triggers.json` files a machine reads. `ok: false` is a file that is refused whole: read as no rules and triggers off, never in part.",
  "cases": [
    {
      "name": "the RFC's two worked examples",
      "file": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-todo",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "start": "claude-code"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 5
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          },
          {
            "name": "monday-report",
            "paused": false,
            "source": {
              "every": "mon 09:00"
            },
            "target": {
              "start": "codex"
            },
            "folder": "~/work/sales",
            "level": "safe",
            "cap": {
              "per_day": 1
            },
            "words": "Make last week's sales report from data/ into reports/."
          }
        ]
      },
      "ok": true
    },
