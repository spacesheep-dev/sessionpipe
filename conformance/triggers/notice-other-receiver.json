          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe",
          "harnesses": [
            "/home/sam/.claude",
            "/home/sam/.codex"
          ],
          "platform": "linux"
        }
      },
