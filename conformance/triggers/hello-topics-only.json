{
  "spec": "CONTROL.md §14.3 (topics in the hello), §1: choices at the terminal",
  "note": "What each hello says of the machine's triggers to one receiver: `on`, and the topics of the rules (not paused) whose source is that receiver, once each. Never a filter, words, target, level, folder, tool or rule name. A machine that knows triggers says `triggers` in every hello, `on: false` with no topics when they are off (the default). A `change` step is the person changing rules or the switch at the machine; a hello goes to every receiver at once.",
  "cases": [
    {
      "name": "two receivers, each told its own topics only",
      "machine": {
        "mode": "auto",
        "folders": [
          "~/work"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "receivers": [
          "board.example",
          "tasks.example"
        ],
        "places": {
          "home": "/home/sam",
          "config": "/home/sam/.config/sessionpipe",
          "state": "/home/sam/.local/state/sessionpipe"
        }
      },
      "triggers": {
        "v": 1,
        "on": true,
        "rules": [
          {
            "name": "card-todo",
            "paused": false,
            "source": {
              "receiver": "board.example",
              "topic": "acme/tasks",
              "event": "record.updated"
            },
            "when": {
              "state": [
                "todo"
              ],
              "for": [
                "studio-claude"
              ]
            },
            "subject": "^X-[0-9]{1,6}$",
            "target": {
              "start": "claude-code"
            },
            "folder": "~/work/acme",
            "level": "edits",
            "tools": [
              "mcp__board"
            ],
            "cap": {
              "per_day": 5
            },
            "words": "Card {subject} is yours and in TODO. Read it with the board tools, do it, move it to REVIEW."
          },
          {
