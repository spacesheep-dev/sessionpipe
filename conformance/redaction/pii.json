{
  "ruleset": "pii@1",
  "cases": [
    {
      "name": "email",
      "in": "ping alice.smith@example.com about it",
      "out": "ping [email] about it"
    },
    {
      "name": "email with plus",
      "in": "from bob+dev@mail.example.org",
      "out": "from [email]"
    },
    {
      "name": "E.164 phone",
      "in": "call +14155551234 tomorrow",
      "out": "call [phone] tomorrow"
    },
    {
      "name": "US phone with punctuation",
      "in": "her number is (415) 555-1234.",
      "out": "her number is [phone]."
    },
    {
      "name": "international phone with spaces",
      "in": "tel +44 20 7946 0958 please",
      "out": "tel [phone] please"
    },
    {
      "name": "home path inside a string",
      "in": "see /Users/misha/spacesheep/README.md",
      "out": "see ~/spacesheep/README.md",
      "home": "/Users/misha"
    },
    {
      "name": "linux home path",
      "in": "cd /home/misha/code && ls",
      "out": "cd ~/code && ls",
      "home": "/home/misha"
    },
    {
      "name": "a version number is not a phone",
      "in": "node 22.23.1 and 185.199.108.153",
      "out": "node 22.23.1 and 185.199.108.153"
    },
    {
      "name": "a short number is not a phone",
      "in": "port 8891, pr 12345",
      "out": "port 8891, pr 12345"
    },
    {
      "name": "a date is not a phone",
      "in": "released 2026-10-31, at 2026-10-31 12:00",
      "out": "released 2026-10-31, at 2026-10-31 12:00"
    },
    {
      "name": "an at-handle is not an email",
      "in": "ask @misha on the feed",
      "out": "ask @misha on the feed"
    }
  ],
  "session": [
    {
      "name": "machine becomes a hash prefix",
      "in": {
        "machine": "misha-air",
        "account_id": "a1b2c3"
      },
      "out": {
        "machine": "81b4709a"
      }
    }
  ]
}
