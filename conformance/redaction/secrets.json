    {
      "name": "private key block",
      "template": "key:\n-----BEGIN OPENSSH PRIVATE KEY-----\n{t}\n{t}\n-----END OPENSSH PRIVATE KEY-----\ndone",
      "t": [
        {
          "prefix": "",
          "len": 64
        }
      ],
      "out": "key:\n[redacted]\ndone"
    },
    {
      "name": "private key cut off",
      "template": "-----BEGIN RSA PRIVATE KEY-----\n{t}",
      "t": [
        {
          "prefix": "",
          "len": 64
        }
      ],
      "out": "[redacted]"
    },
    {
      "name": "authorization header",
      "template": "curl -H \"Authorization: Bearer {t}\" https://api.x",
      "t": [
        {
          "prefix": "",
          "len": 40
        }
      ],
      "out": "curl -H \"Authorization: Bearer [redacted]\" https://api.x"
    },
    {
