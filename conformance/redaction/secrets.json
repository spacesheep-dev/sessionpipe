  "adversarial": [
    {
      "name": "a long identifier of secret words",
      "recipe": {
        "repeat": "password_",
        "times": 5000,
        "then": "=",
        "then_repeat": "a",
        "then_times": 5000
      },
      "max_ms": 500
    },
    {
      "name": "secret words and spaces",
      "recipe": {
        "repeat": "password ",
        "times": 20000
      },
      "max_ms": 500
    },
    {
      "name": "a long whitespace run",
      "recipe": {
        "prefix": "password",
        "repeat": " ",
        "times": 50000,
        "suffix": "is x"
      },
      "max_ms": 500
    },
    {
      "name": "an unterminated key block",
      "recipe": {
        "prefix": "-----BEGIN RSA PRIVATE KEY-----",
        "repeat": "A",
        "times": 200000
      },
      "max_ms": 500
    },
    {
      "name": "URL-ish noise",
      "recipe": {
        "prefix": "postgres://",
        "repeat": "a:",
        "times": 20000
      },
      "max_ms": 500
    },
    {
      "name": "a 200 KB session reply",
      "recipe": {
        "repeat": "Here is the fix. The api_key: ${KEY} stays in env, password is wrong, max_tokens: 4096. ",
        "times": 2500
      },
      "max_ms": 500
    }
  ],
  "note": "Inputs that would look like a real credential are recipes: `template` with {t} replaced by each part`s prefix + rnd(len, abc), where rnd(n, abc) = Array.from({length:n}, (_, i) => abc[(i*7+3) % abc.length]).join(\"\") and abc defaults to [a-zA-Z0-9]. The conformance runner materialises them; no credential-shaped literal is stored.",
  "rnd_default_abc": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
}
