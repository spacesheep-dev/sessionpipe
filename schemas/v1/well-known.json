{
  "$id": "https://sessionpipe.org/schema/v1/well-known.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "max_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "auth": {
      "default": [
        "bearer"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bearer"
        ]
      }
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "events": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "native": {
          "type": "string"
        }
      },
      "required": [
        "events"
      ]
    },
    "batch": {
      "type": "object",
      "properties": {
        "max_events": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      },
      "required": [
        "max_events",
        "max_bytes"
      ]
    },
    "control": {
      "type": "object",
      "properties": {
        "wait_max_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "open_pairing": {
          "type": "boolean"
        },
        "session_tools": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^mcp__[A-Za-z0-9_-]{1,64}$"
          }
        },
        "signing": {
          "type": "object",
          "properties": {
            "rp_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "algs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": -7
                  },
                  {
                    "type": "number",
                    "const": -257
                  }
                ]
              }
            }
          },
          "required": [
            "rp_id",
            "algs"
          ]
        },
        "files": {
          "type": "boolean"
        }
      },
      "required": [
        "wait_max_s",
        "signing"
      ]
    }
  },
  "required": [
    "protocol",
    "max_tier",
    "capabilities",
    "endpoints",
    "batch"
  ]
}
