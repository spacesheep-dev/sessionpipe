{
  "$id": "https://sessionpipe.org/schema/v1/control-ack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "acks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "progress",
              "taken",
              "delivered",
              "expired",
              "unsupported",
              "failed",
              "refused"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "sdk",
              "waiter",
              "turn",
              "api",
              "resume",
              "fork"
            ]
          },
          "session": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}:[A-Za-z0-9._:-]{1,128}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z_]{1,40}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          },
          "reply": {
            "type": "string",
            "maxLength": 20000
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "applied": {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "enum": [
                  "read",
                  "safe",
                  "edits",
                  "auto",
                  "inherit"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@[\\]-]*$"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "outcome",
          "at"
        ]
      }
    }
  },
  "required": [
    "acks"
  ]
}
