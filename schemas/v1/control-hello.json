{
  "$id": "https://sessionpipe.org/schema/v1/control-hello.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "harnesses": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sdk",
          "waiter",
          "turn",
          "api",
          "resume",
          "fork"
        ]
      }
    },
    "keys": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 16,
        "maxLength": 1400,
        "pattern": "^[A-Za-z0-9_-]*$"
      }
    },
    "version": {
      "type": "string",
      "maxLength": 40
    },
    "waiting": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}:[A-Za-z0-9._:-]{1,128}$"
      }
    },
    "folders": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "safe",
        "auto",
        "inherit"
      ]
    },
    "accounts": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "harness",
          "id"
        ]
      }
    },
    "files": {
      "type": "boolean"
    },
    "prompt_files": {
      "type": "boolean"
    },
    "start": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "permissions": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "safe",
                "edits",
                "auto"
              ]
            },
            "uniqueItems": true
          },
          "permission": {
            "type": "string",
            "enum": [
              "read",
              "safe",
              "edits",
              "auto",
              "inherit"
            ]
          },
          "models": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@[\\]-]*$"
            }
          },
          "any_model": {
            "type": "boolean"
          }
        },
        "required": [
          "permissions",
          "permission"
        ]
      },
      "maxProperties": 50
    },
    "key_types": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "passkey",
          "device"
        ]
      }
    }
  },
  "required": [
    "name",
    "harnesses",
    "modes",
    "keys",
    "version"
  ]
}
