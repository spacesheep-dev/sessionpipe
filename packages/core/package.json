{
  "name": "sessionpipe-core",
  "version": "0.9.0",
  "description": "sessionpipe core: protocol types, harness adapters, privacy filter and redaction rulesets, outbox and sinks. Zero runtime dependencies. (published unscoped until the @sessionpipe npm org exists; the code is the same)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesheep-dev/sessionpipe.git",
    "directory": "packages/core"
  },
  "homepage": "https://sessionpipe.org",
  "bugs": "https://github.com/spacesheep-dev/sessionpipe/issues",
  "keywords": [
    "sessionpipe",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "hooks",
    "observability",
    "protocol"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/v1.d.ts",
      "import": "./dist/schema.js"
    },
    "./control": {
      "types": "./dist/src/control/index.d.ts",
      "import": "./dist/control.js"
    },
    "./service": {
      "types": "./dist/src/service/index.d.ts",
      "import": "./dist/service.js"
    },
    "./version": {
      "types": "./dist/src/version.d.ts",
      "import": "./dist/version.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/build.mjs core"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "zod": "^4.6.5"
  }
}
