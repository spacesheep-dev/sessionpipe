{
  "name": "sessionpipe-receiver",
  "version": "0.9.0",
  "description": "The sessionpipe reference receiver: one process, JSONL files, a page you can answer from a phone. (published unscoped until the @sessionpipe npm org exists; the code is the same)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesheep-dev/sessionpipe.git",
    "directory": "packages/receiver"
  },
  "homepage": "https://sessionpipe.org",
  "bugs": "https://github.com/spacesheep-dev/sessionpipe/issues",
  "keywords": [
    "sessionpipe",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "hooks",
    "observability",
    "protocol"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "sessionpipe-receiver": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs receiver"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
