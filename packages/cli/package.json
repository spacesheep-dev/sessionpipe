{
  "name": "sessionpipe",
  "version": "0.9.0",
  "description": "sessionpipe: an open protocol for what your coding agents are doing. One install hooks Claude Code, Codex, Gemini CLI, Antigravity, Devin and more; four privacy tiers; secrets removed on your machine; sent to your server or to none.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacesheep-dev/sessionpipe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://sessionpipe.org",
  "bugs": "https://github.com/spacesheep-dev/sessionpipe/issues",
  "keywords": [
    "sessionpipe",
    "coding-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "devin",
    "hooks",
    "observability",
    "protocol"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "sessionpipe": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs cli"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
