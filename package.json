{
  "name": "sessionpipe-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "An open protocol and client for what your coding agents are doing: hooks for every harness, four privacy tiers, any sink.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w sessionpipe-core && npm run build -w sessionpipe -w sessionpipe-receiver -w sessionpipe-conformance",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "schemas": "node scripts/schemas.mjs",
    "conformance": "node scripts/conformance-fixtures.mjs",
    "fixture-scan": "node scripts/fixture-scan.mjs",
    "bench:hook": "node scripts/bench-hook.mjs",
    "site": "node website/build.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "vectors": "SESSIONPIPE_WRITE_VECTORS=1 vitest run packages/core/test/control-vectors.gen.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "marked": "^18.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
